      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@keyframes collapsible-down": {
          "from": {
            "height": "0",
            "opacity": "0"
          },
          "to": {
            "height": "var(--radix-collapsible-content-height)",
            "opacity": "1"
          }
        },
        "@keyframes collapsible-up": {
          "from": {
            "height": "var(--radix-collapsible-content-height)",
            "opacity": "1"
          },
          "to": {
            "height": "0",
            "opacity": "0"
          }
        },
        "@layer base": {
          ":root": {
            "color-scheme": "dark"
          },
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "html": {
            "@apply bg-background font-sans antialiased": {},
            "font-feature-settings": "\"cv11\" 0, \"ss03\" 0",
            "text-rendering": "optimizeLegibility"
          },
          "body": {
            "@apply min-h-dvh bg-background text-foreground": {}
          },
          "::selection": {
            "background": "color-mix(in srgb, var(--primary) 45%, transparent)"
          },
          "button:not(:disabled), [role=\"button\"]:not(:disabled)": {
            "cursor": "pointer"
          }
        },
        "@utility type-display": {
          "font-size": "40px",
          "line-height": "48px",
          "font-weight": "600",
          "letter-spacing": "-0.02em"
        },
        "@utility type-headline": {
          "font-size": "32px",
          "line-height": "40px",
          "font-weight": "600",
          "letter-spacing": "-0.015em"
        },
        "@utility type-title-lg": {
          "font-size": "24px",
          "line-height": "32px",
          "font-weight": "600",
          "letter-spacing": "-0.01em"
        },
        "@utility type-title": {
          "font-size": "18px",
          "line-height": "24px",
          "font-weight": "600",
          "letter-spacing": "-0.005em"
        },
        "@utility type-body-lg": {
          "font-size": "16px",
          "line-height": "24px",
          "font-weight": "500"
        },
        "@utility type-body": {
          "font-size": "14px",
          "line-height": "20px",
          "font-weight": "500"
        },
        "@utility type-caption": {
          "font-size": "12px",
          "line-height": "16px",
          "font-weight": "500"
        },
        "@utility type-overline": {
          "font-size": "12px",
          "line-height": "16px",
          "font-weight": "600",
          "letter-spacing": "0.08em",
          "text-transform": "uppercase"
        },
        "@utility type-micro": {
          "font-size": "10px",
          "line-height": "12px",
          "font-weight": "600",
          "letter-spacing": "0.08em",
          "text-transform": "uppercase"
        },
        "@utility type-metric-xl": {
          "font-size": "48px",
          "line-height": "56px",
          "font-weight": "500",
          "letter-spacing": "-0.03em",
          "font-variant-numeric": "tabular-nums"
        },
        "@utility type-metric-lg": {
          "font-size": "40px",
          "line-height": "48px",
          "font-weight": "500",
          "letter-spacing": "-0.025em",
          "font-variant-numeric": "tabular-nums"
        },
        "@utility type-metric": {
          "font-size": "32px",
          "line-height": "40px",
          "font-weight": "500",
          "letter-spacing": "-0.02em",
          "font-variant-numeric": "tabular-nums"
        },
        "@utility type-metric-sm": {
          "font-size": "28px",
          "line-height": "36px",
          "font-weight": "500",
          "letter-spacing": "-0.015em",
          "font-variant-numeric": "tabular-nums"
        },
        "@utility type-metric-xs": {
          "font-size": "24px",
          "line-height": "32px",
          "font-weight": "500",
          "letter-spacing": "-0.01em",
          "font-variant-numeric": "tabular-nums"
        },
        "@utility bg-brand-gradient": {
          "background-image": "linear-gradient(180deg, var(--gradient-from), var(--gradient-to))"
        },
        "@utility scrollbar-thin": {
          "scrollbar-width": "thin",
          "scrollbar-color": "var(--border) transparent"
        }
      },
